#!/usr/bin/env bash

set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
API_DIR="${ROOT_DIR}/orders-platform/apps/api"
ARTIFACTS_DIR="${ROOT_DIR}/artifacts/harness"

# Identidad del código verificado (github-26). Se calcula con git hash-object:
# no escribe nada en el repositorio y aplica los filtros de git, de modo que un
# archivo con CRLF en Windows y LF en macOS produce el mismo hash.
SOURCE_STATE_SCOPE="repo:tracked+untracked-not-ignored"
SOURCE_STATE_ALGORITHM="git-hash-object(manifest '<blob> <path>': ls-files --cached then --others --exclude-standard, git order, LF)"
SOURCE_STATE="unknown"
SOURCE_DIRTY="false"
SOURCE_CHANGED_FILES=0
SOURCE_MANIFEST_FILE=""

show_usage() {
  cat <<'EOF'
Engineering Harness

Usage:
  ./harness verify
  ./harness format
  ./harness mutation
  ./harness state
  ./harness help

Commands:
  verify   Run the complete backend verification harness.
  format     Corrige el formato
  mutation Run mutation testing for domain and application.
  state    Print the identity of the source state that would be verified.
  help     Show this help message.
EOF
}

# Calcula la identidad del estado del código: recorre los archivos tracked y los
# untracked no ignorados, arma un manifiesto "<blob> <path>" ordenado y lo hashea.
# No modifica el repositorio (git hash-object sin -w no escribe objetos).
compute_source_state() {
  local tmp_dir paths_file existing_file hashes_file manifest_file path

  SOURCE_STATE="unknown"
  SOURCE_DIRTY="false"
  SOURCE_CHANGED_FILES=0
  SOURCE_MANIFEST_FILE=""

  if ! git -C "${ROOT_DIR}" rev-parse --git-dir >/dev/null 2>&1; then
    return 0
  fi

  tmp_dir="$(mktemp -d)"
  paths_file="${tmp_dir}/paths"
  existing_file="${tmp_dir}/existing"
  hashes_file="${tmp_dir}/hashes"
  manifest_file="${tmp_dir}/manifest"

  # El orden lo fija git, no el `sort` del sistema: git emite cada grupo en
  # orden byte-wise con el mismo código en toda plataforma, mientras que el
  # sort de Windows ordena según el locale. Así el manifiesto (y el state) son
  # idénticos en ./harness y harness.cmd.
  {
    git -C "${ROOT_DIR}" -c core.quotePath=false ls-files --cached --deduplicate
    git -C "${ROOT_DIR}" -c core.quotePath=false ls-files --others --exclude-standard
  } > "${paths_file}"

  : > "${existing_file}"
  : > "${manifest_file}"

  while IFS= read -r path; do
    [[ -z "${path}" ]] && continue

    # un tracked borrado del working tree se queda fuera del manifiesto: su
    # ausencia ya cambia la identidad, y hashearlo fallaría al no existir
    if [[ -e "${ROOT_DIR}/${path}" ]]; then
      printf '%s\n' "${path}" >> "${existing_file}"
    fi
  done < "${paths_file}"

  if [[ -s "${existing_file}" ]]; then
    (
      cd "${ROOT_DIR}"
      git hash-object --stdin-paths < "${existing_file}"
    ) > "${hashes_file}"

    paste -d' ' "${hashes_file}" "${existing_file}" > "${manifest_file}"
  fi

  SOURCE_STATE="$(git -C "${ROOT_DIR}" hash-object --stdin < "${manifest_file}")"
  SOURCE_CHANGED_FILES="$(
    git -C "${ROOT_DIR}" status --porcelain --untracked-files=all 2>/dev/null \
      | grep -c . || true
  )"

  if [[ "${SOURCE_CHANGED_FILES}" -gt 0 ]]; then
    SOURCE_DIRTY="true"
  fi

  SOURCE_MANIFEST_FILE="${manifest_file}"
}

print_source_state() {
  compute_source_state

  cat <<EOF
{
  "dirty": ${SOURCE_DIRTY},
  "state": "${SOURCE_STATE}",
  "stateAlgorithm": "${SOURCE_STATE_ALGORITHM}",
  "scope": "${SOURCE_STATE_SCOPE}",
  "changedFiles": ${SOURCE_CHANGED_FILES}
}
EOF

  if [[ -n "${SOURCE_MANIFEST_FILE}" ]]; then
    rm -rf "$(dirname "${SOURCE_MANIFEST_FILE}")"
  fi
}

copy_test_reports() {
  local evidence_dir="$1"
  local reports_dir="${evidence_dir}/test-reports"

  mkdir -p "${reports_dir}"

  if [[ -d "${API_DIR}/target/surefire-reports" ]]; then
    cp -R \
      "${API_DIR}/target/surefire-reports" \
      "${reports_dir}/surefire-reports"
  fi

  if [[ -d "${API_DIR}/target/failsafe-reports" ]]; then
    cp -R \
      "${API_DIR}/target/failsafe-reports" \
      "${reports_dir}/failsafe-reports"
  fi

  if [[ -f "${API_DIR}/target/quarkus.log" ]]; then
    cp \
      "${API_DIR}/target/quarkus.log" \
      "${reports_dir}/quarkus.log"
  fi

  if [[ -d "${API_DIR}/target/jacoco-reports" ]]; then
    cp -R \
      "${API_DIR}/target/jacoco-reports" \
      "${reports_dir}/jacoco-reports"
  fi

  if [[ -f "${API_DIR}/target/jacoco-quarkus.exec" ]]; then
    cp \
      "${API_DIR}/target/jacoco-quarkus.exec" \
      "${reports_dir}/jacoco-quarkus.exec"
  fi

  if [[ -d "${API_DIR}/target/pit-reports" ]]; then
    cp -R \
      "${API_DIR}/target/pit-reports" \
      "${reports_dir}/pit-reports"
  fi
}

write_verification_report() {
  local evidence_dir="$1"
  local result="$2"
  local exit_code="$3"
  local started_at="$4"
  local finished_at="$5"
  local duration_seconds="$6"
  local commit_sha="$7"
  local branch="$8"

  cat > "${evidence_dir}/verification.json" <<EOF
{
  "schemaVersion": "1.1",
  "command": "./harness verify",
  "component": "orders-platform/apps/api",
  "result": "${result}",
  "exitCode": ${exit_code},
  "startedAt": "${started_at}",
  "finishedAt": "${finished_at}",
  "durationSeconds": ${duration_seconds},
  "git": {
    "commit": "${commit_sha}",
    "branch": "${branch}"
  },
  "source": {
    "dirty": ${SOURCE_DIRTY},
    "state": "${SOURCE_STATE}",
    "stateAlgorithm": "${SOURCE_STATE_ALGORITHM}",
    "scope": "${SOURCE_STATE_SCOPE}",
    "changedFiles": ${SOURCE_CHANGED_FILES},
    "manifest": "source-state.txt"
  },
  "environment": {
    "ci": "${CI:-false}",
    "githubRunId": "${GITHUB_RUN_ID:-local}",
    "githubRunAttempt": "${GITHUB_RUN_ATTEMPT:-local}"
  },
  "evidence": {
    "commandLog": "command.log",
    "testReports": "test-reports",
    "sourceManifest": "source-state.txt"
  }
}
EOF
}

verify_backend() {
  local started_at
  local finished_at
  local started_epoch
  local finished_epoch
  local duration_seconds
  local timestamp
  local commit_sha
  local short_sha
  local branch
  local evidence_dir
  local exit_code
  local result

  started_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  started_epoch="$(date +%s)"
  timestamp="$(date -u +"%Y%m%dT%H%M%SZ")"

  commit_sha="$(git -C "${ROOT_DIR}" rev-parse HEAD 2>/dev/null || echo "unknown")"
  short_sha="$(git -C "${ROOT_DIR}" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
  branch="$(git -C "${ROOT_DIR}" branch --show-current 2>/dev/null || echo "unknown")"

  if [[ -z "${branch}" ]]; then
    branch="${GITHUB_HEAD_REF:-detached}"
  fi

  # la identidad se captura ANTES de Maven: lo que genere el build no puede
  # cambiar el estado que se declara verificado
  compute_source_state

  if [[ "${SOURCE_DIRTY}" == "true" ]]; then
    evidence_dir="${ARTIFACTS_DIR}/${timestamp}-${short_sha}-dirty-${SOURCE_STATE:0:7}"
  else
    evidence_dir="${ARTIFACTS_DIR}/${timestamp}-${short_sha}"
  fi

  mkdir -p "${evidence_dir}"

  if [[ -n "${SOURCE_MANIFEST_FILE}" ]]; then
    cp "${SOURCE_MANIFEST_FILE}" "${evidence_dir}/source-state.txt"
    rm -rf "$(dirname "${SOURCE_MANIFEST_FILE}")"
    SOURCE_MANIFEST_FILE=""
  fi

  echo "=================================================="
  echo " Engineering Harness: backend verification"
  echo "=================================================="
  echo "Repository: ${ROOT_DIR}"
  echo "Backend:    ${API_DIR}"
  echo "Evidence:   ${evidence_dir}"
  echo "Commit:     ${short_sha} (${branch})"

  if [[ "${SOURCE_DIRTY}" == "true" ]]; then
    echo "Source:     DIRTY - ${SOURCE_CHANGED_FILES} archivo(s) local(es) sin commit"
    echo "State:      ${SOURCE_STATE}  (manifiesto: source-state.txt)"
  else
    echo "Source:     working tree limpio"
    echo "State:      ${SOURCE_STATE}"
  fi

  echo

  if [[ ! -d "${API_DIR}" ]]; then
    echo "ERROR: Backend directory not found: ${API_DIR}" \
      | tee "${evidence_dir}/command.log"

    exit_code=2
  elif [[ ! -f "${API_DIR}/mvnw" ]]; then
    echo "ERROR: Maven Wrapper not found: ${API_DIR}/mvnw" \
      | tee "${evidence_dir}/command.log"

    exit_code=2
  else
    chmod +x "${API_DIR}/mvnw"

    set +e

    (
      cd "${API_DIR}"

      ./mvnw \
        --batch-mode \
        --no-transfer-progress \
        clean verify
    ) 2>&1 | tee "${evidence_dir}/command.log"

    exit_code="${PIPESTATUS[0]}"

    set -e
  fi

  finished_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  finished_epoch="$(date +%s)"
  duration_seconds="$((finished_epoch - started_epoch))"

  if [[ "${exit_code}" -eq 0 ]]; then
    result="PASSED"
  else
    result="FAILED"
  fi

  copy_test_reports "${evidence_dir}"

  write_verification_report \
    "${evidence_dir}" \
    "${result}" \
    "${exit_code}" \
    "${started_at}" \
    "${finished_at}" \
    "${duration_seconds}" \
    "${commit_sha}" \
    "${branch}"

  echo
  echo "=================================================="
  echo " HARNESS RESULT: ${result}"

  if [[ "${SOURCE_DIRTY}" == "true" ]]; then
    echo " Source: DIRTY - HEAD ${short_sha} + cambios locales (state ${SOURCE_STATE:0:7})"
  else
    echo " Source: HEAD ${short_sha} (working tree limpio)"
  fi

  echo " Evidence: ${evidence_dir}"
  echo "=================================================="

  return "${exit_code}"
}

mutation_backend() {
  echo "=================================================="
  echo " Engineering Harness: mutation testing"
  echo "=================================================="
  echo "Repository: ${ROOT_DIR}"
  echo "Backend:    ${API_DIR}"
  echo

  if [[ ! -d "${API_DIR}" ]]; then
    echo "ERROR: Backend directory not found: ${API_DIR}" >&2
    exit 2
  fi

  if [[ ! -f "${API_DIR}/mvnw" ]]; then
    echo "ERROR: Maven Wrapper not found: ${API_DIR}/mvnw" >&2
    exit 2
  fi

  chmod +x "${API_DIR}/mvnw"

  (
    cd "${API_DIR}"

    ./mvnw \
      --batch-mode \
      --no-transfer-progress \
      test-compile \
      org.pitest:pitest-maven:mutationCoverage
  )

  echo
  echo "=================================================="
  echo " MUTATION RESULT: COMPLETED"
  echo " Report: ${API_DIR}/target/pit-reports/index.html"
  echo "=================================================="
}

format_backend() {
  echo "=================================================="
  echo " Engineering Harness: apply formatting"
  echo "=================================================="

  if [[ ! -f "${API_DIR}/mvnw" ]]; then
    echo "ERROR: Maven Wrapper not found: ${API_DIR}/mvnw" >&2
    exit 2
  fi

  chmod +x "${API_DIR}/mvnw"

  (
    cd "${API_DIR}"

    ./mvnw \
      --batch-mode \
      --no-transfer-progress \
      spotless:apply
  )

  echo
  echo "=================================================="
  echo " FORMAT RESULT: APPLIED"
  echo "=================================================="
}

COMMAND="${1:-help}"

case "${COMMAND}" in
  verify)
    verify_backend
    ;;
  format)
    format_backend
    ;;
  mutation)
    mutation_backend
    ;;
  state)
    print_source_state
    ;;
  help|--help|-h)
    show_usage
    ;;
  *)
    echo "ERROR: Unknown harness command: ${COMMAND}" >&2
    echo
    show_usage
    exit 2
    ;;
esac